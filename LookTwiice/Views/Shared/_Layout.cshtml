    @using Microsoft.AspNetCore.Identity
    @using LookTwiice.Models
    @using LookTwiice.Models.Constants
    @inject SignInManager<ApplicationUser> SignInManager
    @inject UserManager<ApplicationUser> UserManager

    <!DOCTYPE html>
    <html lang="en" >
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />

            <title>@ViewData["Title"] - LOOKTWiiCE</title>

            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

            <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@300;400;500;600;700&display=swap"
                  rel="stylesheet">

            <link rel="stylesheet"
                  href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

            <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />

            @await RenderSectionAsync("Styles", required: false)
        </head>

        <body>

            <div class="site-wrapper">

                <!-- =========================
                     NAVBAR
                     ========================= -->

                <header class="site-header" id="siteHeader">

                    <nav class="site-navbar">

                        <div class="navbar-container">

                            <!-- LOGO -->

                            <a class="site-brand"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               aria-label="LOOKTWiiCE Home">

                                <img src="~/images/LookTwiice_Logo.png"
                                     alt="LOOKTWiiCE"
                                     class="brand-logo" />

                            </a>


                            <!-- MOBILE BUTTON -->

                            <button type="button"
                                    class="navbar-toggle"
                                    id="navbarToggle"
                                    aria-label="Toggle navigation"
                                    aria-expanded="false">

                                <span></span>
                                <span></span>

                            </button>


                            <!-- NAVIGATION -->

                            <div class="navbar-collapse"
                                 id="navbarCollapse">

                                <div class="site-nav">

                                    <a class="nav-link-custom"
                                       asp-area=""
                                       asp-controller="Portfolio"
                                       asp-action="Index">

                                        <span class="nav-number">01</span>
                                        <span>Portfolio</span>

                                    </a>

                                    <a asp-area="" asp-controller="Portfolio"
                                       asp-action="WeddingGallery"
                                       class="nav-link-custom">
                                        <span class="nav-number">02</span>
                                        WEDDING GALLERY
                                    </a>


                                    <a class="nav-link-custom"
                                       asp-area=""
                                       asp-controller="About"
                                       asp-action="Index">

                                        <span class="nav-number">03</span>
                                        <span>About</span>

                                    </a>


                                    <a class="nav-link-custom"
                                       asp-area=""
                                       asp-controller="Contact"
                                       asp-action="Index">

                                        <span class="nav-number">04</span>
                                        <span>Contact</span>

                                    </a>

                                </div>


                                <!-- RIGHT SIDE -->

                                <div class="navbar-actions">

                                    @if (User.IsInRole(RoleNames.Admin))
                                    {
                                        <a class="nav-account-link"
                                           asp-area="Admin"
                                           asp-controller="Admin"
                                           asp-action="Index">
                                            ADMIN
                                        </a>
                                        <a class="nav-account-link"
                                           asp-area="Photographer"
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            PHOTOGRAPHER
                                        </a>
                                    }

                                    @if (User.IsInRole(RoleNames.Photographer))
                                    {
                                        <a class="nav-account-link"
                                           asp-area="Photographer"
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            PHOTOGRAPHER
                                        </a>
                                    }

                                    <!-- LANGUAGE -->

                                    <div class="language-wrapper">

                                        <form asp-controller="Culture"
                                              asp-action="SetLanguage"
                                              method="get">

                                            <input type="hidden"
                                                   name="returnUrl"
                                                   value="@Context.Request.Path" />

                                            <select name="culture"
                                                    class="language-select"
                                                    onchange="this.form.submit()">

                                                <option value="en">EN</option>
                                                <option value="tr">TR</option>
                                                <option value="de">DE</option>

                                            </select>

                                        </form>

                                    </div>



                                    <!-- AUTH -->

                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <a class="nav-account-link"
                                           asp-area="Identity"
                                           asp-page="/Account/Manage/Index">
                                            Account
                                        </a>

                                        <form asp-area="Identity"
                                              asp-page="/Account/Logout"
                                              method="post"
                                              class="d-inline">
                                            <button type="submit" class="nav-account-link logout-button">
                                                Logout
                                            </button>
                                        </form>

                                
                                    }
                                    else
                                    {
                                        <a class="nav-account-link"
                                           asp-area="Identity"
                                           asp-page="/Account/Login">
                                            Login
                                        </a>
                                    }

                                </div>

                            </div>

                        </div>

                    </nav>

                </header>


                <!-- =========================
                     MAIN
                     ========================= -->

                <main role="main" class="site-main">

                    @RenderBody()

                </main>


                <!-- =========================
                     FOOTER
                     ========================= -->

                <footer class="site-footer">

                    <div class="container">

                        <div class="footer-top">

                            <div class="footer-brand">

                                <img src="~/images/LookTwiice_Logo.png"
                                     alt="LOOKTWiiCE"
                                     class="footer-logo" />
                                <p>
                                    Photography with perspective.
                                </p>

                            </div>


                            <div class="footer-links">

                                <a asp-area=""
                                   asp-controller="Portfolio"
                                   asp-action="Index">
                                   Portfolio
                                </a>

                        

                                <a asp-area=""
                                   asp-controller="About"
                                   asp-action="Index">
                                    About
                                </a>

                                <a asp-area=""
                                   asp-controller="Contact"
                                   asp-action="Index">
                                    Contact
                                </a>

                            </div>


                            <div class="footer-social">

                                <a href="https://www.instagram.com/looktwice.photo"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-label="Instagram">
                                    Instagram
                                </a>

                                <a href="mailto:hello@looktwiice.com">
                                    Email
                                </a>

                            </div>

                        </div>


                        <div class="footer-bottom">

                            <span>
                                © @DateTime.Now.Year LOOKTWiiCE
                            </span>

                            <span>
                                All rights reserved.
                            </span>

                        </div>

                    </div>

                </footer>

            </div>


            <!-- =========================
                 SCRIPTS
                 ========================= -->

            <script src="~/lib/jquery/dist/jquery.min.js"></script>

            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

            <script src="~/js/site.js"
                    asp-append-version="true"></script>


          <script>

                document.addEventListener("DOMContentLoaded", function () {

                    const header = document.getElementById("siteHeader");
                    const toggle = document.getElementById("navbarToggle");
                    const collapse = document.getElementById("navbarCollapse");

                    /* =========================
                       NAVBAR SCROLL
                       ========================= */

                    let lastScrollY = window.scrollY;

                    function handleScroll() {

                        const currentScrollY = window.scrollY;

                        if (currentScrollY > 30) {
                            header.classList.add("scrolled");
                        }
                        else {
                            header.classList.remove("scrolled");
                        }

                        if (window.innerWidth <= 768) {

                            const menuOpen = collapse.classList.contains("show");

                            if (currentScrollY <= 30) {
                                header.classList.remove("nav-hidden");
                            }
                            else if (currentScrollY > lastScrollY) {
                                header.classList.add("nav-hidden");
                            }
                            else if (currentScrollY < lastScrollY) {
                                header.classList.remove("nav-hidden");
                            }

                        }

                        lastScrollY = currentScrollY;
                    }

                    window.addEventListener("scroll", handleScroll);

                    handleScroll();


                    /* =========================
                       MOBILE MENU
                       ========================= */

                    if (toggle && collapse) {

                        toggle.addEventListener("click", function () {

                            const isOpen =
                                collapse.classList.toggle("show");

                            toggle.classList.toggle(
                                "active",
                                isOpen
                            );

                            toggle.setAttribute(
                                "aria-expanded",
                                isOpen
                            );

                            document.body.style.overflow =
                                isOpen ? "hidden" : "";

                        });


                        collapse.querySelectorAll("a").forEach(link => {

                            link.addEventListener("click", function () {

                                collapse.classList.remove("show");

                                toggle.classList.remove("active");

                                toggle.setAttribute(
                                    "aria-expanded",
                                    "false"
                                );

                                document.body.style.overflow = "";

                            });

                        });

                    }

                });

          </script>

            @await RenderSectionAsync("Scripts", required: false)

        </body>
    </html>