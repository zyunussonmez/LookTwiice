@{
    ViewData["Title"] = "About";
}
@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}
<main class="about-page">

    <!-- INTRO -->
    <section class="about-intro">
        <div class="container about-intro-container">

            <div class="about-label">
                <span>LOOKTWiiCE</span>
                <span>01</span>
            </div>

            <div class="about-intro-content">

                <p class="about-eyebrow">
                    ABOUT / OUR PERSPECTIVE
                </p>

                <h1 class="about-title">
                    More than
                    <span>a photograph.</span>
                </h1>

                <p class="about-lead">
                    We believe the best photographs don't simply
                    show a moment. They make you feel it again.
                </p>

            </div>

        </div>
    </section>


    <!-- STORY -->
    <section class="about-story">
        <div class="container">

            <div class="about-section-header">

                <div class="about-label">
                    <span>LOOKTWiiCE</span>
                    <span>02</span>
                </div>

                <div>
                    <p class="about-eyebrow">
                        OUR STORY
                    </p>

                    <h2 class="about-section-title">
                        Every story deserves
                        <span>its own perspective.</span>
                    </h2>
                </div>

            </div>

            <div class="about-story-grid">

                <div class="about-story-number">
                    01
                </div>

                <div class="about-story-text">

                    <p>
                        LOOKTWiiCE was created with a simple idea:
                        photography should feel personal.
                    </p>

                    <p>
                        From the quiet moments between a couple
                        to the energy of a fashion editorial, we
                        look for the details that make each story
                        different.
                    </p>

                    <p>
                        Our approach combines natural moments,
                        thoughtful composition and an editorial
                        perspective to create photographs that
                        feel authentic and timeless.
                    </p>

                </div>

            </div>

        </div>
    </section>


    <!-- APPROACH -->
    <section class="about-approach">
        <div class="container">

            <div class="about-section-header">

                <div class="about-label">
                    <span>LOOKTWiiCE</span>
                    <span>03</span>
                </div>

                <div>
                    <p class="about-eyebrow">
                        OUR APPROACH
                    </p>

                    <h2 class="about-section-title">
                        See differently.
                        <span>Feel everything.</span>
                    </h2>
                </div>

            </div>


            <div class="about-values">

                <div class="about-value">
                    <div class="about-value-top">
                        <span class="about-value-number">01</span>
                        <span class="about-value-line"></span>
                    </div>

                    <div class="about-value-content">
                        <h3>Authentic</h3>

                        <p>
                            We don't force moments.
                            We let them happen naturally.
                        </p>
                    </div>

                    <span class="about-value-arrow">↗</span>
                </div>


                <div class="about-value">
                    <div class="about-value-top">
                        <span class="about-value-number">02</span>
                        <span class="about-value-line"></span>
                    </div>

                    <div class="about-value-content">
                        <h3>Editorial</h3>

                        <p>
                            We bring a cinematic and
                            editorial perspective to every story.
                        </p>
                    </div>

                    <span class="about-value-arrow">↗</span>
                </div>


                <div class="about-value">
                    <div class="about-value-top">
                        <span class="about-value-number">03</span>
                        <span class="about-value-line"></span>
                    </div>

                    <div class="about-value-content">
                        <h3>Intentional</h3>

                        <p>
                            Every frame has a reason.
                            Every detail matters.
                        </p>
                    </div>

                    <span class="about-value-arrow">↗</span>
                </div>

            </div>

        </div>
    </section>


    <!-- SERVICES -->
    <section class="about-services">
        <div class="container">

            <div class="about-section-header">

                <div class="about-label">
                    <span>LOOKTWiiCE</span>
                    <span>04</span>
                </div>

                <div>
                    <p class="about-eyebrow">
                        WHAT WE PHOTOGRAPH
                    </p>

                    <h2 class="about-section-title">
                        Stories in
                        <span>different forms.</span>
                    </h2>
                </div>

            </div>


            <div class="about-service-list">

                <a asp-controller="Services"
                   asp-action="Index"
                   class="about-service">

                    <span>01</span>

                    <div class="about-service-content">
                        <h3>Wedding</h3>
                        <p>Weddings & Engagements</p>
                    </div>

                    <span class="about-service-arrow">↗</span>

                </a>


                <a asp-controller="Services"
                   asp-action="Index"
                   class="about-service">

                    <span>02</span>

                    <div class="about-service-content">
                        <h3>Fashion</h3>
                        <p>Editorial & Model Photography</p>
                    </div>

                    <span class="about-service-arrow">↗</span>

                </a>


                <a asp-controller="Services"
                   asp-action="Index"
                   class="about-service">

                    <span>03</span>

                    <div class="about-service-content">
                        <h3>Portrait</h3>
                        <p>Personal & Branding</p>
                    </div>

                    <span class="about-service-arrow">↗</span>

                </a>


                <a asp-controller="Services"
                   asp-action="Index"
                   class="about-service">

                    <span>04</span>

                    <div class="about-service-content">
                        <h3>Event</h3>
                        <p>Events & Campaigns</p>
                    </div>

                    <span class="about-service-arrow">↗</span>

                </a>

            </div>

        </div>
    </section>


    <!-- CTA -->
    <section class="about-cta">

        <div class="container about-cta-container">

            <p class="about-eyebrow">
                HAVE A STORY TO TELL?
            </p>

            <h2 class="about-cta-title">
                Let's create something
                <span>worth remembering.</span>
            </h2>

            <a asp-controller="Contact"
               asp-action="Index"
               class="about-cta-button">

                <span>START A PROJECT</span>
                <span>→</span>

            </a>

        </div>

    </section>

</main>