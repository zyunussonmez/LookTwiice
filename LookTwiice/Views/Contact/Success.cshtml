@{
    ViewData["Title"] = "Thank You";
}

<link rel="stylesheet"
      href="~/css/contact.css"
      asp-append-version="true" />

<section class="contact-success">

    <div class="contact-success__image">

        <img src="~/images/wedding_1.jpeg"
             alt="LookTwiice photography" />

        <div class="contact-success__overlay"></div>

    </div>


    <div class="contact-success__content">

        <span class="contact-success__eyebrow">
            THANK YOU
        </span>

        <h1>
            We'll be<br />
            in touch.
        </h1>

        <p>
            Your story has reached us.
            We'll get back to you shortly.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="contact-success__link">

            <span>Back to home</span>

            <span>→</span>

        </a>

    </div>

</section>