@using LookTwiice.Models
@model List<Category>

@{
    ViewData["Title"] = "Portfolio";
    var categoryIndex = 0;
}

@section Styles {
   
    <link rel="stylesheet"
          href="~/css/portfolio-page.css"
          asp-append-version="true" />
}

<main class="portfolio-experiment">

    <!-- ==========================================
         CATEGORY WALL
         ========================================== -->

    <section class="category-wall">

        <div class="category-wall__line"></div>

        <div class="category-wall__items">

            @foreach (var category in Model)
            {
                var photos = category.Galleries
                    .SelectMany(g => g.Photos)
                    .OrderByDescending(p => p.IsFeatured)
                    .ThenBy(p => p.DisplayOrder)
                    .ToList();

                var representativePhoto =
                    photos.FirstOrDefault();

                if (representativePhoto == null)
                    continue;

                var index = categoryIndex++;

                <a href="#category-@category.Id"
                   class="category-photo"
                   data-category="@category.Id">

                    <div class="category-photo__string"></div>

                    <div class="category-photo__frame">

                        <span class="category-photo__clip"></span>

                        <img src="@representativePhoto.WebUrl"
                             alt="@category.Name"
                             loading="lazy" />

                    </div>

                    <span class="category-photo__label">

                        <span class="category-photo__number">
                            @((index + 1).ToString("00"))
                        </span>

                        @category.Name

                    </span>

                </a>
            }

        </div>

    </section>


    <!-- ==========================================
         CATEGORY SECTIONS
         ========================================== -->

    <main class="portfolio-categories">

        @foreach (var category in Model)
        {
            var photos = category.Galleries
                .SelectMany(g => g.Photos)
                .OrderByDescending(p => p.IsFeatured)
                .ThenBy(p => p.DisplayOrder)
                .ToList();

            if (!photos.Any())
                continue;

            <section id="category-@category.Id"
                     class="portfolio-category">

                <div class="portfolio-category__header">

                    <div class="portfolio-category__title">

                        <span class="portfolio-category__eyebrow">
                            CATEGORY
                        </span>

                        <h2>
                            @category.Name
                        </h2>

                    </div>

                    <span class="portfolio-category__count">
                        @photos.Count.ToString("00") photographs
                    </span>

                </div>


                <div class="portfolio-category__wall">

                    @foreach (var photo in photos)
                    {
                        <figure class="portfolio-photo">

                            <button type="button"
                                    class="portfolio-photo__button"
                                    data-photo="@photo.WebUrl"
                                    data-title="@photo.Title"
                                    data-category="@category.Id">

                                <img src="@photo.WebUrl"
                                     alt="@photo.Title"
                                     loading="lazy" />

                            </button>

                        </figure>
                    }

                </div>

            </section>
        }

    </main>


    <!-- ==========================================
         END SECTION
         ========================================== -->

    <section class="portfolio-end">

        <div class="portfolio-end__line"></div>

        <span class="portfolio-end__eyebrow">
            THE END
        </span>

        <h2>
            Until the next<br />
            frame.
        </h2>

        <div class="portfolio-end__meta">

            <span>LOOKTWiiCE</span>
            <span>PORTFOLIO</span>

        </div>

    </section>


    <!-- ==========================================
         LIGHTBOX
         ========================================== -->

    <div class="portfolio-lightbox"
         id="portfolioLightbox"
         aria-hidden="true">

        <div class="portfolio-lightbox__backdrop"></div>

        <div class="portfolio-lightbox__content">

            <button type="button"
                    class="portfolio-lightbox__close"
                    id="lightboxClose"
                    aria-label="Close">
                ×
            </button>

            <button type="button"
                    class="portfolio-lightbox__prev"
                    id="lightboxPrev"
                    aria-label="Previous photo">
                ←
            </button>

            <figure class="portfolio-lightbox__figure">

                <img id="lightboxImage"
                     src=""
                     alt="" />

                <figcaption id="lightboxCaption"></figcaption>

            </figure>

            <button type="button"
                    class="portfolio-lightbox__next"
                    id="lightboxNext"
                    aria-label="Next photo">
                →
            </button>

        </div>

    </div>

</main>

<script src="~/js/portfolio-page.js"
        asp-append-version="true"></script>