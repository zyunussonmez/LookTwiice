@{
    ViewData["Title"] = "Home";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<main class="home-page">

    <!-- =========================================
         HERO
         ========================================= -->

    <section class="hero">

        <!-- Background / Placeholder -->
        <div class="hero-background">

            <div class="hero-background">
                <img src="~/images/wedding_1.jpeg" alt="LookTwiice Photography" class="hero-image" />
            </div>

        </div>


        <!-- Dark overlay -->
        <div class="hero-overlay"></div>


        <!-- Hero content -->
        <div class="hero-content container">

            <div class="hero-meta">

                <span>WEDDING</span>
                <span>FASHION</span>
                <span>PORTRAIT</span>

            </div>


            <div class="hero-title">

                <span class="hero-title-line">
                    YOUR STORY.
                </span>

                <span class="hero-title-line hero-title-indent">
                    OUR PERSPECTIVE.
                </span>

            </div>


            <div class="hero-bottom">

                <p class="hero-description">
                    Capturing moments, emotions and stories
                    through a different perspective.
                </p>


                <a asp-controller="Portfolio"
                   asp-action="Index"
                   class="hero-button">

                    <span>VIEW WORK</span>

                    <span class="hero-button-arrow">
                        →
                    </span>

                </a>

            </div>

        </div>


        <!-- Scroll indicator -->

        <div class="hero-scroll">

            <span>SCROLL</span>

            <span class="hero-scroll-line"></span>

        </div>

    </section>


    <!-- =========================================
         INTRO PLACEHOLDER
         ========================================= -->

    <section class="home-intro">
        <div class="container intro-container">
            <div class="intro-label">
                <span>LOOKTWiiCE</span>
                <span>01</span>
            </div>

            <div class="intro-content">
                <div class="intro-copy">
                    <h2 class="intro-title">
                        More than
                        <span>a photograph.</span>
                    </h2>

                    <p class="intro-description">
                        We create honest, timeless imagery for
                        stories worth remembering.
                    </p>
                </div>

                <div class="intro-image-placeholder">
                    <span>PHOTO</span>
                    <small>PLACEHOLDER</small>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================
     FEATURED WORK
     ========================================= -->

    <section class="featured-work">
        <div class="container">
            <div class="featured-header">
                <div class="featured-label">
                    <span>LOOKTWiiCE</span>
                    <span>02</span>
                </div>

                <div class="featured-heading">
                    <h2 class="featured-title">
                        Selected
                        <span>stories.</span>
                    </h2>
                </div>
            </div>

            <div class="featured-grid">
                <a href="#" class="featured-item featured-item-large">
                    <div class="featured-image featured-placeholder-1">
                        <span class="featured-placeholder-text">WEDDING</span>
                    </div>

                    <div class="featured-info">
                        <div>
                            <span class="featured-number">01</span>
                            <span class="featured-name">Wedding</span>
                        </div>

                        <span class="featured-arrow">→</span>
                    </div>
                </a>

                <a href="#" class="featured-item featured-item-small">
                    <div class="featured-image featured-placeholder-2">
                        <span class="featured-placeholder-text">FASHION</span>
                    </div>

                    <div class="featured-info">
                        <div>
                            <span class="featured-number">02</span>
                            <span class="featured-name">Fashion</span>
                        </div>

                        <span class="featured-arrow">→</span>
                    </div>
                </a>

                <a href="#" class="featured-item featured-item-wide">
                    <div class="featured-image featured-placeholder-3">
                        <span class="featured-placeholder-text">PORTRAIT</span>
                    </div>

                    <div class="featured-info">
                        <div>
                            <span class="featured-number">03</span>
                            <span class="featured-name">Portrait</span>
                        </div>

                        <span class="featured-arrow">→</span>
                    </div>
                </a>
            </div>

            <div class="featured-all">
                <a asp-controller="Portfolio" asp-action="Index">
                    VIEW ALL WORK
                    <span>→</span>
                </a>
            </div>
        </div>
    </section>

    <!-- =========================================
     SERVICES
     ========================================= -->

    <section class="home-services">

        <div class="container">

            <div class="services-header">

                <div class="services-label">
                    <span>LOOKTWiiCE</span>
                    <span>03</span>
                </div>

                <div>

                    <p class="services-eyebrow">
                        WHAT WE DO
                    </p>

                    <h2 class="services-title">
                        Stories in
                        <span>different forms.</span>
                    </h2>

                </div>

            </div>


            <!-- SERVICES LIST -->

            <div class="services-list">

                <!-- WEDDING -->

                <a href="#" class="service-item">
                    <div class="service-number">
                        01
                    </div>

                    <div class="service-content">
                        <h3>Wedding</h3>
                        <p>Weddings & Engagements</p>
                    </div>

                    <div class="service-arrow">
                        →
                    </div>

                    <div class="service-preview service-preview-wedding">
                        <div class="service-preview-image">
                            <span>01</span>
                        </div>

                        <div class="service-preview-image">
                            <span>02</span>
                        </div>

                        <div class="service-preview-image">
                            <span>03</span>
                        </div>
                    </div>
                </a>


                <!-- FASHION -->

                <a href="#" class="service-item">
                    <div class="service-number">
                        02
                    </div>

                    <div class="service-content">
                        <h3>Fashion</h3>
                        <p>Editorial & Model Photography</p>
                    </div>

                    <div class="service-arrow">
                        →
                    </div>

                    <div class="service-preview service-preview-fashion">
                        <div class="service-preview-image">
                            <span>01</span>
                        </div>

                        <div class="service-preview-image">
                            <span>02</span>
                        </div>

                        <div class="service-preview-image">
                            <span>03</span>
                        </div>
                    </div>
                </a>


                <!-- PORTRAIT -->

                <a href="#" class="service-item">
                    <div class="service-number">
                        03
                    </div>

                    <div class="service-content">
                        <h3>Portrait</h3>
                        <p>Personal & Branding</p>
                    </div>

                    <div class="service-arrow">
                        →
                    </div>

                    <div class="service-preview service-preview-portrait">
                        <div class="service-preview-image">
                            <span>01</span>
                        </div>

                        <div class="service-preview-image">
                            <span>02</span>
                        </div>

                        <div class="service-preview-image">
                            <span>03</span>
                        </div>
                    </div>
                </a>


                <!-- EVENT -->

                <a href="#" class="service-item">
                    <div class="service-number">
                        04
                    </div>

                    <div class="service-content">
                        <h3>Event</h3>
                        <p>Events & Campaigns</p>
                    </div>

                    <div class="service-arrow">
                        →
                    </div>

                    <div class="service-preview service-preview-event">
                        <div class="service-preview-image">
                            <span>01</span>
                        </div>

                        <div class="service-preview-image">
                            <span>02</span>
                        </div>

                        <div class="service-preview-image">
                            <span>03</span>
                        </div>
                    </div>
                </a>

            </div>


            <!-- BOOKING CTA -->

            <div class="services-cta">

                <p>
                    Have a project in mind?
                </p>

                <a href="#">
                    START A PROJECT
                    <span>→</span>
                </a>

            </div>

        </div>

    </section>

    <!-- =========================================
     ABOUT / STORY
     ========================================= -->

    <section class="home-about">
        <div class="container">
            <div class="about-label">
                <span>LOOKTWiiCE</span>
                <span>04</span>
            </div>

            <div class="about-main">
                <div class="about-content">
                    <h2 class="about-title">
                        Stories
                        <span>worth remembering.</span>
                    </h2>

                    <p class="about-lead">
                        We create photographs that feel as real
                        as the moments they come from.
                    </p>

                    <a asp-controller="About"
                       asp-action="Index"
                       class="about-link">
                        MORE ABOUT US
                        <span>→</span>
                    </a>
                </div>

                <div class="about-image">
                    <div class="about-placeholder">
                        <span>PHOTO</span>
                        <small>PLACEHOLDER</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>