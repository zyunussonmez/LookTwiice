@model IEnumerable<LookTwiice.Models.Gallery>

@{
    ViewData["Title"] = "Home";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<main class="home-page">

    <!-- =========================================
         HERO
         ========================================= -->

    <section class="hero">

        <!-- Background / Placeholder -->
        <div class="hero-background">

            <div class="hero-background">
                <img src="~/images/wedding_1.jpeg" alt="LookTwiice Photography" class="hero-image" />
            </div>

        </div>


        <!-- Dark overlay -->
        <div class="hero-overlay"></div>


        <!-- Hero content -->
        <div class="hero-content container">

            <div class="hero-meta">

                <span>WEDDING</span>
                <span>FASHION</span>
                <span>PORTRAIT</span>

            </div>


            <div class="hero-title">

                <span class="hero-title-line">
                    YOUR STORY.
                </span>

                <span class="hero-title-line hero-title-indent">
                    OUR PERSPECTIVE.
                </span>

            </div>


            <div class="hero-bottom">

                <p class="hero-description">
                    Capturing moments, emotions and stories
                    through a different perspective.
                </p>


                <a asp-controller="Portfolio"
                   asp-action="Index"
                   class="hero-button">

                    <span>VIEW WORK</span>

                    <span class="hero-button-arrow">
                        →
                    </span>

                </a>

            </div>

        </div>


        <!-- Scroll indicator -->

        <div class="hero-scroll">

            <span>SCROLL</span>

            <span class="hero-scroll-line"></span>

        </div>

    </section>


    <!-- =========================================
         INTRO PLACEHOLDER
         ========================================= -->

    <section class="home-intro">
        <div class="container intro-container">
            <div class="intro-label">
                <span>LOOKTWiiCE</span>
                <span>01</span>
            </div>

            <div class="intro-content">
                <div class="intro-copy">
                    <h2 class="intro-title">
                        More than
                        <span>a photograph.</span>
                    </h2>

                    <p class="intro-description">
                        We create honest, timeless imagery for
                        stories worth remembering.
                    </p>
                </div>

                <div class="intro-image-placeholder">
                    <span>PHOTO</span>
                    <small>PLACEHOLDER</small>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================
     FEATURED WORK
     ========================================= -->

    <section class="featured-work">

        <div class="container">

            <div class="featured-header">

                <div class="featured-label">
                    <span>SELECTED WORK</span>
                    <span>02</span>
                </div>

                <h2 class="featured-title">
                    Featured
                    <span>work.</span>
                </h2>

            </div>


            <div class="featured-grid">

                @{
                    var featuredIndex = 0;
                }

                @foreach (var gallery in Model.Take(3))
                {
                    var featuredPhoto = gallery.Photos
                        .OrderByDescending(p => p.IsFeatured)
                        .ThenBy(p => p.DisplayOrder)
                        .FirstOrDefault();

                    if (featuredPhoto == null)
                    {
                        continue;
                    }

                    featuredIndex++;

                    var itemClass = featuredIndex switch
                    {
                        1 => "featured-item featured-item-large",
                        2 => "featured-item featured-item-small",
                        _ => "featured-item featured-item-wide"
                    };

                    <a asp-controller="Portfolio"
                       asp-action="Gallery"
                       asp-route-slug="@gallery.Slug"
                       class="@itemClass">

                        <div class="featured-image">

                            <img src="@featuredPhoto.WebUrl"
                                 alt="@featuredPhoto.Title"
                                 loading="lazy"
                                 style="width:100%; height:100%; object-fit:cover;" />

                        </div>

                        <div class="featured-info">

                            <div>

                                <span class="featured-number">
                                    @featuredIndex.ToString("D2")
                                </span>

                                <span class="featured-name">
                                    @gallery.Title
                                </span>

                            </div>

                            <span class="featured-arrow">
                                →
                            </span>

                        </div>

                    </a>
                }

            </div>


            <div class="featured-all">

                <a asp-controller="Portfolio"
                   asp-action="Index">

                    VIEW ALL WORK
                    <span>→</span>

                </a>

            </div>

        </div>

    </section>

    <!-- =========================================
     SERVICES
     ========================================= -->

    <section class="home-services">

        <div class="container">

            <div class="services-header">

                <div class="services-label">
                    <span>LOOKTWiiCE</span>
                    <span>03</span>
                </div>

                <div>

                    <p class="services-eyebrow">
                        WHAT WE DO
                    </p>

                    <h2 class="services-title">
                        Stories in
                        <span>different forms.</span>
                    </h2>

                </div>

            </div>


            <!-- SERVICES LIST -->

            <div class="services-list">

                @{
                    var homeCategories = ViewBag.Categories
                        as IEnumerable<LookTwiice.Models.Category>
                        ?? Enumerable.Empty<LookTwiice.Models.Category>();

                    var homeWedding = homeCategories
                        .FirstOrDefault(c =>
                            c.Name.Equals("Wedding", StringComparison.OrdinalIgnoreCase));

                    var homeOtherCategories = homeCategories
                        .Where(c => homeWedding == null || c.Id != homeWedding.Id)
                        .ToList();
                }


                @* =========================
       WEDDING
       ========================= *@

                @if (homeWedding != null)
                {
                    <a asp-controller="Portfolio"
                       asp-action="Index"
                       asp-route-categoryId="@homeWedding.Id"
                       class="service-item">

                        <div class="service-number">
                            01
                        </div>

                        <div class="service-content">
                            <h3>@homeWedding.Name</h3>
                            <p>Weddings & Engagements</p>
                        </div>

                        <div class="service-arrow">
                            →
                        </div>

                        @{
                            var weddingPhotos = homeWedding?.Galleries
                                .SelectMany(g => g.Photos)
                                .OrderByDescending(p => p.IsFeatured)
                                .ThenBy(p => p.DisplayOrder)
                                .Take(3)
                                .ToList()
                                ?? new List<LookTwiice.Models.Photo>();
                        }

                        <div class="service-preview service-preview-wedding">

                            @foreach (var photo in weddingPhotos)
                            {
                                <div class="service-preview-image">

                                    <img src="@photo.ThumbnailUrl"
                                         alt="@photo.Title"
                                         loading="lazy" />

                                </div>
                            }

                        </div>

                    </a>
                }


                @* =========================
       OTHER CATEGORIES
       ========================= *@

                @{
                    var serviceNumber = 2;
                }

                @foreach (var category in homeOtherCategories)
                {
                    <a asp-controller="Portfolio"
                       asp-action="Index"
                       asp-route-categoryId="@category.Id"
                       class="service-item">

                        <div class="service-number">
                            @serviceNumber.ToString("D2")
                        </div>

                        <div class="service-content">

                            <h3>@category.Name</h3>

                            <p>
                                @switch (category.Name.ToLowerInvariant())
                                {
                                    case "fashion":
                                        @:Editorial & Model Photography
                                        break;

                                    case "portrait":
                                        @:Personal & Branding
                                        break;

                                    case "event":
                                        @:Events & Campaigns
                                        break;

                                    default:
                                        @:Photography & Visual Stories
                                        break;
                                }
                            </p>

                        </div>

                        <div class="service-arrow">
                            →
                        </div>

                        @{
                            var categoryPhotos = category.Galleries
                                .SelectMany(g => g.Photos)
                                .OrderByDescending(p => p.IsFeatured)
                                .ThenBy(p => p.DisplayOrder)
                                .Take(3)
                                .ToList();
                        }

                        <div class="service-preview">

                            @foreach (var photo in categoryPhotos)
                            {
                                <div class="service-preview-image">

                                    <img src="@photo.ThumbnailUrl"
                                         alt="@photo.Title"
                                         loading="lazy" />

                                </div>
                            }

                        </div>

                    </a>

                    serviceNumber++;
                }

            </div>


            <!-- BOOKING CTA -->

            <div class="services-cta">

                <p>
                    Have a project in mind?
                </p>

                <a href="#">
                    START A PROJECT
                    <span>→</span>
                </a>

            </div>

        </div>

    </section>

    <!-- =========================================
     ABOUT / STORY
     ========================================= -->

    <section class="home-about">
        <div class="container">
            <div class="about-label">
                <span>LOOKTWiiCE</span>
                <span>04</span>
            </div>

            <div class="about-main">
                <div class="about-content">
                    <h2 class="about-title">
                        Stories
                        <span>worth remembering.</span>
                    </h2>

                    <p class="about-lead">
                        We create photographs that feel as real
                        as the moments they come from.
                    </p>

                    <a asp-controller="About"
                       asp-action="Index"
                       class="about-link">
                        MORE ABOUT US
                        <span>→</span>
                    </a>
                </div>

                <div class="about-image">
                    <div class="about-placeholder">
                        <span>PHOTO</span>
                        <small>PLACEHOLDER</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>