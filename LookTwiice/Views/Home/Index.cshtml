@{
    ViewData["Title"] = "Home";
}

<main class="home-page">

    <!-- =========================================
         HERO
         ========================================= -->

    <section class="hero">

        <!-- Background / Placeholder -->
        <div class="hero-background">

            <div class="hero-placeholder">

                <span class="hero-placeholder-label">
                    PHOTOGRAPHY
                </span>

            </div>

        </div>


        <!-- Dark overlay -->
        <div class="hero-overlay"></div>


        <!-- Hero content -->
        <div class="hero-content container">

            <div class="hero-meta">

                <span>WEDDING</span>
                <span>FASHION</span>
                <span>PORTRAIT</span>

            </div>


            <div class="hero-title">

                <span class="hero-title-line">
                    YOUR STORY.
                </span>

                <span class="hero-title-line hero-title-indent">
                    OUR PERSPECTIVE.
                </span>

            </div>


            <div class="hero-bottom">

                <p class="hero-description">
                    Capturing moments, emotions and stories
                    through a different perspective.
                </p>


                <a asp-controller="Portfolio"
                   asp-action="Index"
                   class="hero-button">

                    <span>VIEW WORK</span>

                    <span class="hero-button-arrow">
                        →
                    </span>

                </a>

            </div>

        </div>


        <!-- Scroll indicator -->

        <div class="hero-scroll">

            <span>SCROLL</span>

            <span class="hero-scroll-line"></span>

        </div>

    </section>


    <!-- =========================================
         INTRO PLACEHOLDER
         ========================================= -->

    <section class="home-intro">

        <div class="container intro-container">

            <div class="intro-label">
                <span>LOOKTWiiCE</span>
                <span>01</span>
            </div>


            <div class="intro-content">

                <p class="intro-eyebrow">
                    PHOTOGRAPHY / VISUAL STORIES
                </p>

                <h2 class="intro-title">
                    We capture the
                    <span>moments that matter.</span>
                </h2>

                <p class="intro-description">
                    From intimate weddings to bold fashion stories,
                    we create photographs that preserve more than
                    just a moment.
                </p>

            </div>

        </div>

    </section>

    <!-- =========================================
     FEATURED WORK
     ========================================= -->

    <section class="featured-work">

        <div class="container">

            <div class="featured-header">

                <div class="featured-label">
                    <span>LOOKTWiiCE</span>
                    <span>02</span>
                </div>

                <div>

                    <p class="featured-eyebrow">
                        SELECTED WORK
                    </p>

                    <h2 class="featured-title">
                        A selection of
                        <span>our stories.</span>
                    </h2>

                </div>

            </div>


            <!-- WORK GRID -->

            <div class="featured-grid">


                <!-- WEDDING -->

                <a href="#"
                   class="featured-item featured-item-large">

                    <div class="featured-image featured-placeholder-1">

                        <span class="featured-placeholder-text">
                            WEDDING
                        </span>

                    </div>

                    <div class="featured-info">

                        <div>
                            <span class="featured-number">
                                01
                            </span>

                            <span class="featured-name">
                                Wedding
                            </span>
                        </div>

                        <span class="featured-arrow">
                            →
                        </span>

                    </div>

                </a>


                <!-- FASHION -->

                <a href="#"
                   class="featured-item featured-item-small">

                    <div class="featured-image featured-placeholder-2">

                        <span class="featured-placeholder-text">
                            FASHION
                        </span>

                    </div>

                    <div class="featured-info">

                        <div>
                            <span class="featured-number">
                                02
                            </span>

                            <span class="featured-name">
                                Fashion
                            </span>
                        </div>

                        <span class="featured-arrow">
                            →
                        </span>

                    </div>

                </a>


                <!-- PORTRAIT -->

                <a href="#"
                   class="featured-item featured-item-wide">

                    <div class="featured-image featured-placeholder-3">

                        <span class="featured-placeholder-text">
                            PORTRAIT
                        </span>

                    </div>

                    <div class="featured-info">

                        <div>
                            <span class="featured-number">
                                03
                            </span>

                            <span class="featured-name">
                                Portrait
                            </span>
                        </div>

                        <span class="featured-arrow">
                            →
                        </span>

                    </div>

                </a>

            </div>


            <!-- ALL WORK -->

            <div class="featured-all">

                <a asp-controller="Portfolio"
                   asp-action="Index">

                    VIEW ALL WORK

                    <span>→</span>

                </a>

            </div>

        </div>

    </section>

    <!-- =========================================
     SERVICES
     ========================================= -->

    <section class="home-services">

        <div class="container">

            <div class="services-header">

                <div class="services-label">
                    <span>LOOKTWiiCE</span>
                    <span>03</span>
                </div>

                <div>

                    <p class="services-eyebrow">
                        WHAT WE DO
                    </p>

                    <h2 class="services-title">
                        Stories in
                        <span>different forms.</span>
                    </h2>

                </div>

            </div>


            <!-- SERVICES LIST -->

            <div class="services-list">


                <!-- WEDDING -->

                <a href="#"
                   class="service-item">

                    <div class="service-number">
                        01
                    </div>

                    <div class="service-content">

                        <h3>
                            Wedding
                        </h3>

                        <p>
                            Weddings & Engagements
                        </p>

                    </div>

                    <div class="service-arrow">
                        →
                    </div>

                    <div class="service-preview service-preview-wedding">

                        <span>
                            WEDDING
                        </span>

                    </div>

                </a>


                <!-- FASHION -->

                <a href="#"
                   class="service-item">

                    <div class="service-number">
                        02
                    </div>

                    <div class="service-content">

                        <h3>
                            Fashion
                        </h3>

                        <p>
                            Editorial & Model Photography
                        </p>

                    </div>

                    <div class="service-arrow">
                        →
                    </div>

                    <div class="service-preview service-preview-fashion">

                        <span>
                            FASHION
                        </span>

                    </div>

                </a>


                <!-- PORTRAIT -->

                <a href="#"
                   class="service-item">

                    <div class="service-number">
                        03
                    </div>

                    <div class="service-content">

                        <h3>
                            Portrait
                        </h3>

                        <p>
                            Personal & Branding
                        </p>

                    </div>

                    <div class="service-arrow">
                        →
                    </div>

                    <div class="service-preview service-preview-portrait">

                        <span>
                            PORTRAIT
                        </span>

                    </div>

                </a>


                <!-- EVENT -->

                <a href="#"
                   class="service-item">

                    <div class="service-number">
                        04
                    </div>

                    <div class="service-content">

                        <h3>
                            Event
                        </h3>

                        <p>
                            Events & Campaigns
                        </p>

                    </div>

                    <div class="service-arrow">
                        →
                    </div>

                    <div class="service-preview service-preview-event">

                        <span>
                            EVENT
                        </span>

                    </div>

                </a>

            </div>


            <!-- BOOKING CTA -->

            <div class="services-cta">

                <p>
                    Have a project in mind?
                </p>

                <a href="#">
                    START A PROJECT
                    <span>→</span>
                </a>

            </div>

        </div>

    </section>

    <!-- =========================================
     ABOUT / STORY
     ========================================= -->

    <section class="home-about">

        <div class="container">

            <div class="about-header">

                <div class="about-label">
                    <span>LOOKTWiiCE</span>
                    <span>04</span>
                </div>

                <div>
                    <p class="about-eyebrow">
                        THE STORY BEHIND THE LENS
                    </p>

                    <h2 class="about-title">
                        More than
                        <span>just a photograph.</span>
                    </h2>
                </div>

            </div>


            <!-- ABOUT MAIN -->

            <div class="about-main">

                <!-- IMAGE -->

                <div class="about-image">

                    <div class="about-placeholder">

                        <span>
                            LOOKTWiiCE
                        </span>

                    </div>

                </div>


                <!-- CONTENT -->

                <div class="about-content">

                    <p class="about-lead">
                        We believe a photograph should do more
                        than show what happened.
                    </p>

                    <p class="about-text">
                        It should bring back the atmosphere,
                        the emotion and the little details that
                        made that moment yours.
                    </p>

                    <p class="about-text">
                        From weddings and portraits to fashion
                        stories and creative campaigns, we focus
                        on creating images with character,
                        emotion and perspective.
                    </p>

                    <a href="#"
                       class="about-link">

                        MORE ABOUT US

                        <span>→</span>

                    </a>

                </div>

            </div>


            <!-- STATS -->

            <div class="about-stats">

                <div class="about-stat">

                    <span class="about-stat-number">
                        08+
                    </span>

                    <span class="about-stat-label">
                        YEARS OF EXPERIENCE
                    </span>

                </div>


                <div class="about-stat">

                    <span class="about-stat-number">
                        120+
                    </span>

                    <span class="about-stat-label">
                        PROJECTS
                    </span>

                </div>


                <div class="about-stat">

                    <span class="about-stat-number">
                        15+
                    </span>

                    <span class="about-stat-label">
                        CITIES
                    </span>

                </div>


                <div class="about-stat">

                    <span class="about-stat-number">
                        04
                    </span>

                    <span class="about-stat-label">
                        SPECIALTIES
                    </span>

                </div>

            </div>

        </div>

    </section>

</main>