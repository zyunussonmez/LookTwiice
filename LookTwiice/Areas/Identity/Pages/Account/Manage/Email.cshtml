@page
@model EmailModel

@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="account-profile">

    <div class="account-profile__header">
        <span class="account-profile__eyebrow">
            ACCOUNT · EMAIL
        </span>

        <h2>Email Adresi</h2>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="email-form"
          method="post"
          class="profile-form">

        <div asp-validation-summary="All"
             class="profile-validation"
             role="alert">
        </div>

        <div class="profile-field">

            <label asp-for="Email">
                Mevcut Email
            </label>

            <div class="account-email-status">

                <input asp-for="Email"
                       class="profile-input"
                       disabled />

                @if (Model.IsEmailConfirmed)
                {
                    <span class="account-email-status__confirmed">
                        VERIFIED
                    </span>
                }

            </div>

            @if (!Model.IsEmailConfirmed)
            {
                <button id="email-verification"
                        type="submit"
                        asp-page-handler="SendVerificationEmail"
                        class="account-inline-action">
                    Doğrulama emaili gönder →
                </button>
            }

        </div>

        <div class="profile-field">

            <label asp-for="Input.NewEmail">
                Yeni Email
            </label>

            <input asp-for="Input.NewEmail"
                   class="profile-input"
                   autocomplete="email"
                   aria-required="true"
                   placeholder="ornek@email.com" />

            <span asp-validation-for="Input.NewEmail"
                  class="profile-error">
            </span>

        </div>

        <div class="profile-form__footer">

            <span>EMAIL</span>

            <button id="change-email-button"
                    type="submit"
                    asp-page-handler="ChangeEmail"
                    class="profile-save">

                <span>Email'i Güncelle</span>
                <span>→</span>

            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}