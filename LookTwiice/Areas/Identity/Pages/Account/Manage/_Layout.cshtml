@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) &&
        parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="container account-settings-container">

    <h1>Hesap Ayarları</h1>

    <div class="account-settings-divider"></div>

    <div class="row">

        <!-- SIDEBAR -->
        <div class="col-md-3 account-settings-sidebar">

            <button type="button"
                    class="account-mobile-menu"
                    id="accountMobileMenu"
                    aria-expanded="false">

                <span>ACCOUNT MENU</span>

                <span class="account-mobile-menu__arrow">
                    ↓
                </span>

            </button>

            <div class="account-manage-nav"
                 id="accountManageNav">

                <partial name="_ManageNav" />

            </div>

        </div>

        <!-- CONTENT -->
        <div class="col-md-9 account-settings-content">

            @RenderBody()

        </div>

    </div>

</div>

@section Styles {

    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />

    @RenderSection("Styles", required: false)
}

@section Scripts {
    @RenderSection("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const button =
                document.getElementById("accountMobileMenu");

            const nav =
                document.getElementById("accountManageNav");

            if (!button || !nav) return;

            button.addEventListener("click", function () {

                const isOpen =
                    nav.classList.toggle("is-open");

                button.classList.toggle("is-open", isOpen);

                button.setAttribute(
                    "aria-expanded",
                    isOpen.toString()
                );

            });

            nav.querySelectorAll("a").forEach(function (link) {

                link.addEventListener("click", function () {

                    nav.classList.remove("is-open");
                    button.classList.remove("is-open");

                    button.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                });

            });

        });
    </script>
}