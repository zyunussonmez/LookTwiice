@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="account-profile">

    <div class="account-profile__header">
        <span class="account-profile__eyebrow">
            ACCOUNT · SECURITY
        </span>

        <h2>Şifre Değiştir</h2>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form"
          method="post"
          class="profile-form">

        <div asp-validation-summary="ModelOnly"
             class="profile-validation"
             role="alert">
        </div>

        <div class="profile-field">

            <label asp-for="Input.OldPassword">
                Mevcut Şifre
            </label>

            <input asp-for="Input.OldPassword"
                   class="profile-input"
                   autocomplete="current-password"
                   aria-required="true"
                   placeholder="Mevcut şifreniz" />

            <span asp-validation-for="Input.OldPassword"
                  class="profile-error">
            </span>

        </div>

        <div class="profile-field">

            <label asp-for="Input.NewPassword">
                Yeni Şifre
            </label>

            <input asp-for="Input.NewPassword"
                   class="profile-input"
                   autocomplete="new-password"
                   aria-required="true"
                   placeholder="Yeni şifreniz" />

            <span asp-validation-for="Input.NewPassword"
                  class="profile-error">
            </span>

        </div>

        <div class="profile-field">

            <label asp-for="Input.ConfirmPassword">
                Yeni Şifre Tekrar
            </label>

            <input asp-for="Input.ConfirmPassword"
                   class="profile-input"
                   autocomplete="new-password"
                   aria-required="true"
                   placeholder="Yeni şifrenizi tekrar girin" />

            <span asp-validation-for="Input.ConfirmPassword"
                  class="profile-error">
            </span>

        </div>

        <div class="profile-form__footer">

            <span>SECURITY</span>

            <button type="submit"
                    class="profile-save">

                <span>Şifreyi Güncelle</span>
                <span>→</span>

            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}