@page
@model PersonalDataModel

@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="account-profile">

    <div class="account-profile__header">
        <span class="account-profile__eyebrow">
            ACCOUNT · DATA
        </span>

        <h2>Kişisel Veriler</h2>
    </div>

    <div class="personal-data">

        <div class="personal-data__intro">
            <p>
                Hesabınızla ilişkilendirilmiş kişisel verilerinizi
                buradan indirebilir veya hesabınızı tamamen silebilirsiniz.
            </p>
        </div>

        <div class="personal-data__warning">
            <span class="personal-data__warning-label">
                IMPORTANT
            </span>

            <p>
                Hesabınızı silmek tüm kişisel verilerinizi kalıcı olarak
                kaldırır. Bu işlem geri alınamaz.
            </p>
        </div>

        <div class="personal-data__actions">

            <form id="download-data"
                  asp-page="DownloadPersonalData"
                  method="post">

                <button class="account-action-button
                    account-action-button--primary"
                        type="submit">
                    Verilerimi İndir
                    <span>↓</span>
                </button>

            </form>

            <a id="delete"
               asp-page="DeletePersonalData"
               class="account-action-button
                account-action-button--danger">
                Hesabı Sil
                <span>→</span>
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}