@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel

@{
    ViewData["Title"] = "Two-factor authentication";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="account-profile">

    <div class="account-profile__header">
        <span class="account-profile__eyebrow">
            ACCOUNT · SECURITY
        </span>

        <h2>İki Faktörlü Doğrulama</h2>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    @{
        var consentFeature =
            HttpContext.Features.Get<ITrackingConsentFeature>();
    }

    @if (consentFeature?.CanTrack ?? true)
    {
        <div class="account-security">

            @if (Model.Is2faEnabled)
            {
                <div class="security-status">
                    <span class="security-status__label">
                        TWO-FACTOR AUTHENTICATION
                    </span>

                    <span class="security-status__value">
                        ENABLED
                    </span>
                </div>

                @if (Model.RecoveryCodesLeft == 0)
                {
                    <div class="security-alert security-alert--danger">
                        <strong>
                            Kurtarma kodunuz kalmadı.
                        </strong>

                        <p>
                            Giriş yapabilmek için yeni bir kurtarma kodu
                            seti oluşturmanız gerekiyor.
                        </p>

                        <a asp-page="./GenerateRecoveryCodes">
                            Yeni kurtarma kodları oluştur →
                        </a>
                    </div>
                }
                else if (Model.RecoveryCodesLeft == 1)
                {
                    <div class="security-alert security-alert--danger">
                        <strong>
                            Son 1 kurtarma kodunuz kaldı.
                        </strong>

                        <p>
                            Yeni bir kurtarma kodu seti oluşturmanız önerilir.
                        </p>

                        <a asp-page="./GenerateRecoveryCodes">
                            Yeni kurtarma kodları oluştur →
                        </a>
                    </div>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <div class="security-alert security-alert--warning">
                        <strong>
                            @Model.RecoveryCodesLeft kurtarma kodunuz kaldı.
                        </strong>

                        <p>
                            Yeni bir kurtarma kodu seti oluşturmanız önerilir.
                        </p>

                        <a asp-page="./GenerateRecoveryCodes">
                            Yeni kurtarma kodları oluştur →
                        </a>
                    </div>
                }

                <div class="security-actions">

                    @if (Model.IsMachineRemembered)
                    {
                        <form method="post">
                            <button type="submit"
                                    class="account-action-button">
                                Bu tarayıcıyı unut
                            </button>
                        </form>
                    }

                    <a asp-page="./Disable2fa"
                       class="account-action-button account-action-button--danger">
                        2FA'yı devre dışı bırak
                    </a>

                    <a asp-page="./GenerateRecoveryCodes"
                       class="account-action-button">
                        Kurtarma kodlarını yenile
                    </a>

                </div>
            }

            <div class="security-section">

                <div class="security-section__header">
                    <span class="account-profile__eyebrow">
                        AUTHENTICATOR
                    </span>

                    <h3>Authenticator Uygulaması</h3>
                </div>

                @if (!Model.HasAuthenticator)
                {
                    <p class="security-description">
                        Hesabınızı korumak için bir authenticator uygulaması
                        bağlayabilirsiniz.
                    </p>

                    <a id="enable-authenticator"
                       asp-page="./EnableAuthenticator"
                       class="account-action-button account-action-button--primary">
                        Authenticator ekle →
                    </a>
                }
                else
                {
                    <p class="security-description">
                        Authenticator uygulamanız hesabınıza bağlı.
                    </p>

                    <div class="security-actions">

                        <a id="enable-authenticator"
                           asp-page="./EnableAuthenticator"
                           class="account-action-button account-action-button--primary">
                            Authenticator'ı yeniden kur
                        </a>

                        <a id="reset-authenticator"
                           asp-page="./ResetAuthenticator"
                           class="account-action-button">
                            Authenticator'ı sıfırla
                        </a>

                    </div>
                }

            </div>

        </div>
    }
    else
    {
        <div class="security-alert security-alert--danger">
            <strong>
                Gizlilik ve çerez politikası kabul edilmedi.
            </strong>

            <p>
                İki faktörlü doğrulamayı etkinleştirmek için
                politikayı kabul etmeniz gerekiyor.
            </p>
        </div>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}