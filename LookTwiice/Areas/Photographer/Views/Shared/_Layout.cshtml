@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/photographer.css"
          asp-append-version="true" />
}

<div class="photographer-shell" id="photographerShell">

    <aside class="photographer-sidebar">

        <div class="photographer-sidebar-header">

            <span class="photographer-sidebar-label">
                WORKSPACE
            </span>

            <span class="photographer-sidebar-title">
                Photographer
            </span>

        </div>

        <nav class="photographer-nav">

            <a asp-area="Photographer"
               asp-controller="Dashboard"
               asp-action="Index"
               class="photographer-nav-link">

                <span>01</span>
                <span>Dashboard</span>

            </a>

            <div class="photographer-nav-section">
                Portfolio
            </div>

            <a asp-area="Photographer"
               asp-controller="Portfolio"
               asp-action="Categories"
               class="photographer-nav-link">

                <span>02</span>
                <span>Categories</span>

            </a>

            <a href="#"
               class="photographer-nav-link">

                <span>03</span>
                <span>Galleries</span>

            </a>

            <a href="#"
               class="photographer-nav-link">

                <span>04</span>
                <span>Photos</span>

            </a>

        </nav>

        <div class="photographer-sidebar-bottom">

            <a asp-area="Identity"
               asp-page="/Account/Manage/Index">
                Account
            </a>

        </div>

    </aside>

    <main class="photographer-content">

        @RenderBody()

    </main>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const shell =
                document.getElementById("photographerShell");

            const toggle =
                document.getElementById("photographerSidebarToggle");

            if (!toggle) {
                return;
            }

            toggle.addEventListener("click", function() {

                shell.classList.toggle("sidebar-collapsed");

            });

        });
    </script>

}