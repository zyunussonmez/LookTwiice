@model LookTwiice.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">PORTFOLIO</span>
        <h1>Edit Category</h1>
    </div>
</div>

<form asp-area="Photographer"
      asp-controller="Portfolio"
      asp-action="EditCategory"
      method="post"
      class="category-form">

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div class="form-group">
        <label asp-for="Slug">Slug</label>
        <input asp-for="Slug" />
        <span asp-validation-for="Slug"></span>
    </div>

    <button type="submit">
        SAVE CHANGES
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}