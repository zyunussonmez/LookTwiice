@model IEnumerable<LookTwiice.Models.Gallery>

@{
    ViewData["Title"] = "Galleries";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">PORTFOLIO</span>
        <h1>Galleries</h1>
    </div>

    <a asp-area="Photographer"
       asp-controller="Portfolio"
       asp-action="CreateGallery"
       class="page-action">
        ADD GALLERY +
    </a>
</div>

<div class="category-list">
    @if (Model != null && Model.Any())
    {
        <div class="category-list-header">
            <span>TITLE</span>
            <span>CATEGORY</span>
            <span>SLUG</span>
            <span>ACTIONS</span>
        </div>

        @foreach (var gallery in Model)
        {
            <div class="category-row">
                <div class="category-name">
                    @gallery.Title
                </div>

                <div class="category-slug">
                    @(gallery.Category?.Name ?? "-")
                </div>

                <div class="category-slug">
                    /@gallery.Slug
                </div>

                <div class="category-actions">
                    <a asp-area="Photographer"
                       asp-controller="Portfolio"
                       asp-action="Photos"
                       asp-route-galleryId="@gallery.Id">
                        PHOTOS
                    </a>

                    <a asp-area="Photographer"
                       asp-controller="Portfolio"
                       asp-action="EditGallery"
                       asp-route-id="@gallery.Id">
                        EDIT
                    </a>

                    <form asp-area="Photographer"
                          asp-controller="Portfolio"
                          asp-action="DeleteGallery"
                          asp-route-id="@gallery.Id"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this gallery?');">

                        <button type="submit">
                            DELETE
                        </button>

                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <div class="category-empty">
            <span>No galleries found.</span>

            <a asp-area="Photographer"
               asp-controller="Portfolio"
               asp-action="CreateGallery">
                Create your first gallery →
            </a>
        </div>
    }
</div>