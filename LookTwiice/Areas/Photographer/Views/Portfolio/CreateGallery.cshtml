@model LookTwiice.Models.Gallery

@{
    ViewData["Title"] = "Create Gallery";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">PORTFOLIO</span>
        <h1>Create Gallery</h1>
    </div>
</div>

<form asp-area="Photographer"
      asp-controller="Portfolio"
      asp-action="CreateGallery"
      method="post"
      class="category-form">

    <div class="form-group">
        <label asp-for="Title">Title</label>
        <input asp-for="Title" placeholder="e.g. Cappadocia Wedding" />
        <span asp-validation-for="Title"></span>
    </div>

    <div class="form-group">
        <label asp-for="Slug">Slug</label>
        <input asp-for="Slug" placeholder="e.g. cappadocia-wedding" />
        <span asp-validation-for="Slug"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description"
                  rows="5"
                  placeholder="Describe this gallery..."></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId">Category</label>

        <select asp-for="CategoryId">
            <option value="0">Select a category</option>

            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id">
                    @category.Name
                </option>
            }
        </select>

        <span asp-validation-for="CategoryId"></span>
    </div>

    <div class="form-group">
        <label>
            <input asp-for="IsFeatured" />
            Featured Gallery
        </label>
    </div>

    <button type="submit">
        CREATE GALLERY
    </button>

</form> 