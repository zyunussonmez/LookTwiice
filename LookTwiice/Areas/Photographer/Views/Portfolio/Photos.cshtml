@model IEnumerable<LookTwiice.Models.Photo>

@{
    ViewData["Title"] = "Photos";
    var gallery = ViewBag.Gallery as LookTwiice.Models.Gallery;
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">PORTFOLIO / GALLERY</span>
        <h1>@gallery?.Title</h1>
    </div>

    <a asp-area="Photographer"
       asp-controller="Portfolio"
       asp-action="CreatePhoto"
       asp-route-galleryId="@gallery?.Id"
       class="page-action">
        UPLOAD PHOTO +
    </a>
</div>

<div class="photo-list">

    @if (Model != null && Model.Any())
    {
        <div class="photo-grid"
             id="photoGrid"
             data-gallery-id="@gallery?.Id">

            @foreach (var photo in Model)
            {
                <div class="photo-card"
                     data-photo-id="@photo.Id">

                    <div class="photo-preview">

                        <div class="photo-drag-handle">
                            ⋮⋮
                        </div>

                        <img src="@photo.ThumbnailUrl"
                             alt="@photo.Title" />

                    </div>

                    <div class="photo-card-info">

                        <div>
                            <span class="photo-order">
                                @photo.DisplayOrder.ToString("D2")
                            </span>

                            <span class="photo-title">
                                @photo.Title
                            </span>
                        </div>

                        @if (photo.IsFeatured)
                        {
                            <span class="photo-featured">
                                FEATURED
                            </span>
                        }

                    </div>

                    <div class="photo-card-actions">

                        <a asp-area="Photographer"
                           asp-controller="Portfolio"
                           asp-action="EditPhoto"
                           asp-route-id="@photo.Id">
                            EDIT
                        </a>

                        <form asp-area="Photographer"
                              asp-controller="Portfolio"
                              asp-action="DeletePhoto"
                              asp-route-id="@photo.Id"
                              method="post"
                              onsubmit="return confirm('Delete this photo?');">

                            <button type="submit">
                                DELETE
                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="category-empty">

            <span>No photos found.</span>

            <a asp-area="Photographer"
               asp-controller="Portfolio"
               asp-action="CreatePhoto"
               asp-route-galleryId="@gallery?.Id">
                Upload your first photo →
            </a>

        </div>
    }

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

    @Html.AntiForgeryToken()

    <script>

        const photoGrid = document.getElementById("photoGrid");

        if (photoGrid) {

            new Sortable(photoGrid, {

                animation: 200,

                handle: ".photo-drag-handle",

                ghostClass: "photo-sort-ghost",

                onEnd: async function() {

                    const photoIds = Array.from(
                        photoGrid.querySelectorAll(".photo-card")
                    ).map(card => Number(card.dataset.photoId));

                    const galleryId = Number(
                        photoGrid.dataset.galleryId
                    );

                    const token = document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value;

                    try {

                        const response = await fetch(
                            '@Url.Action("ReorderPhotos", "Portfolio", new { area = "Photographer" })',
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": token
                                },

                                body: JSON.stringify({
                                    galleryId: galleryId,
                                    photoIds: photoIds
                                })
                            }
                        );

                        if (!response.ok) {
                            throw new Error("Photo order could not be saved.");
                        }

                        console.log("Photo order saved.");

                    }
                    catch (error) {

                        console.error(error);

                        alert("Photo order could not be saved.");

                    }

                }

            });

        }

    </script>

}