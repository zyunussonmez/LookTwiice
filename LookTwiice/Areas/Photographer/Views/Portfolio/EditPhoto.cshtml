@model LookTwiice.Models.Photo

@{
    ViewData["Title"] = "Edit Photo";
}

<div class="page-header">
    <div>
        <span class="page-eyebrow">PORTFOLIO / PHOTO</span>
        <h1>Edit Photo</h1>
        <p>@Model.Gallery?.Title</p>
    </div>
</div>

<div class="photo-edit-layout">

    <div class="photo-edit-preview">
        <img src="@Model.WebUrl"
             alt="@Model.Title" />
    </div>

    <form asp-area="Photographer"
          asp-controller="Portfolio"
          asp-action="EditPhoto"
          asp-route-id="@Model.Id"
          method="post"
          class="category-form">

        <div class="form-group">
            <label asp-for="Title">Title</label>

            <input asp-for="Title"
                   placeholder="e.g. Sunset Portrait" />

            <span asp-validation-for="Title"></span>
        </div>

        <div class="form-group">
            <label asp-for="DisplayOrder">
                Display Order
            </label>

            <input asp-for="DisplayOrder"
                   type="number"
                   min="0" />

            <span asp-validation-for="DisplayOrder"></span>
        </div>

        <div class="form-group">
            <label>
                <input asp-for="IsFeatured" />
                Featured Photo
            </label>
        </div>

        <div class="photo-edit-meta">

            <div>
                <span>RESOLUTION</span>
                <strong>
                    @Model.Width × @Model.Height
                </strong>
            </div>

            <div>
                <span>FILE SIZE</span>
                <strong>
                    @(Math.Round(Model.FileSize / 1024d / 1024d, 2)) MB
                </strong>
            </div>

            <div>
                <span>TYPE</span>
                <strong>
                    @Model.MimeType
                </strong>
            </div>

        </div>

        <div class="form-actions">

            <a asp-area="Photographer"
               asp-controller="Portfolio"
               asp-action="Photos"
               asp-route-galleryId="@Model.GalleryId">
                CANCEL
            </a>

            <button type="submit">
                SAVE CHANGES
            </button>

        </div>

    </form>

</div>