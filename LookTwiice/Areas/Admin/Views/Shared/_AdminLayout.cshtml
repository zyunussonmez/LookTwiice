@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
}

<div class="admin-shell" id="adminShell">

    <aside class="admin-sidebar">

        <div class="admin-sidebar-title">
            Yönetim Paneli
        </div>

        <nav class="admin-nav">

            <a class="admin-nav-link"
               asp-area="Admin"
               asp-controller="Admin"
               asp-action="Index">
                Panel
            </a>

            <a class="admin-nav-link"
               asp-area="Admin"
               asp-controller="Users"
               asp-action="Index">
                Kullanıcılar
            </a>

        </nav>

    </aside>

    <main class="admin-content">

        @RenderBody()

    </main>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const sidebarToggle =
                document.getElementById("sidebarToggle");

            const adminShell =
                document.getElementById("adminShell");

            const sidebarState =
                localStorage.getItem("adminSidebar");

            if (sidebarState === "collapsed") {
                adminShell.classList.add("sidebar-collapsed");
            }

            sidebarToggle?.addEventListener("click", function() {

                adminShell.classList.toggle("sidebar-collapsed");

                const isCollapsed =
                    adminShell.classList.contains("sidebar-collapsed");

                localStorage.setItem(
                    "adminSidebar",
                    isCollapsed ? "collapsed" : "open"
                );

            });

        });
    </script>

}